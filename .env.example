# Postgres connection (Neon: use the pooled URL here and the direct URL in DIRECT_URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familybudget"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/familybudget"
# Shared household password (both of you use the same one)
HOUSEHOLD_PASSWORD="change-me"
# Random 32+ char secret used to sign the session cookie
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: which seed to run. "household" uses prisma/seed.household.ts (gitignored), anything else uses demo data.
SEED_PROFILE="demo"
