# Postgres connection string. On Vercel this is injected automatically when you create a
# database from the Storage tab; locally point it at your own Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familybudget"
# Optional: direct (non-pooled) URL for migrations. Leave unset — the scripts fall back to DATABASE_URL.
# DIRECT_URL=""
# Shared household password (both of you use the same one)
HOUSEHOLD_PASSWORD="change-me"
# Random 32+ character secret used to sign the session cookie (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"
